Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Never rewrite real files (assets, robots.txt)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Language-prefixed routes. English has no prefix and is the canonical root.
RewriteRule ^(de|fr|es|it|pl|pt|nl)/?$                         index.php?lang=$1 [L,QSA]
RewriteRule ^(de|fr|es|it|pl|pt|nl)/tender/([A-Za-z0-9._:-]+)/?$ tender.php?lang=$1&id=$2 [L,QSA]
RewriteRule ^(de|fr|es|it|pl|pt|nl)/country/([A-Za-z]{2})/?$   list.php?lang=$1&mode=country&c=$2 [L,QSA]
RewriteRule ^(de|fr|es|it|pl|pt|nl)/category/([0-9]{2})/?$     list.php?lang=$1&mode=category&d=$2 [L,QSA]
RewriteRule ^(de|fr|es|it|pl|pt|nl)/search/?$                  list.php?lang=$1&mode=search [L,QSA]
RewriteRule ^(de|fr|es|it|pl|pt|nl)/countries/?$               countries.php?lang=$1 [L,QSA]
RewriteRule ^(de|fr|es|it|pl|pt|nl)/categories/?$              categories.php?lang=$1 [L,QSA]

RewriteRule ^tender/([A-Za-z0-9._:-]+)/?$        tender.php?id=$1        [L,QSA]
RewriteRule ^country/([A-Za-z]{2})/?$            list.php?mode=country&c=$1 [L,QSA]
RewriteRule ^category/([0-9]{2})/?$              list.php?mode=category&d=$1 [L,QSA]
RewriteRule ^search/?$                           list.php?mode=search    [L,QSA]
RewriteRule ^countries/?$                        countries.php           [L,QSA]
RewriteRule ^categories/?$                       categories.php          [L,QSA]
RewriteRule ^api/?$                              api-docs.php            [L,QSA]
RewriteRule ^api/tenders\.json$                  api.php                 [L,QSA]
RewriteRule ^api/tender/([A-Za-z0-9._:-]+)\.json$ api.php?id=$1          [L,QSA]
RewriteRule ^llms\.txt$                          llms.php                [L]
RewriteRule ^sitemap\.xml$                       sitemap.php             [L]
RewriteRule ^sitemap-pages\.xml$                 sitemap.php?part=pages  [L]
RewriteRule ^sitemap-([a-z]{2})\.xml$            sitemap.php?part=$1     [L]
RewriteRule ^sitemap-lang-([a-z]{2})\.xml$       sitemap.php?part=lang&lang=$1 [L]
</IfModule>

# Keep the library out of the web
<FilesMatch "^(db|render|i18n|i18n-data|cache|guides)\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/json application/xml text/plain
</IfModule>
